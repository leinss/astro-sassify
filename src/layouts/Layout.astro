---
import '../styles/global.css';
import '../styles/transitions.css';
import { ClientRouter } from 'astro:transitions';
import i18n from '../assets/i18n.json';

export interface Props {
  title: string;
  description?: string;
}

// Default language is German ('de')
const lang = 'de';

const {
  title,
  description=i18n[lang as keyof typeof i18n].meta.description,
} = Astro.props;
---

<!doctype html>
<html lang={Astro.url.pathname.includes('/ai-communication') ? 'en' : 'de'} x-data="{ darkMode: localStorage.getItem('darkMode') === 'true' }" x-init="
  $watch('darkMode', val => localStorage.setItem('darkMode', val));
" :class="{ 'dark': darkMode }">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Lexend:wght@400;500;600;700&display=swap" rel="stylesheet">

    <ClientRouter />
  </head>

  <body class="antialiased bg-white dark:bg-secondary-950 text-secondary-900 dark:text-secondary-100 transition-colors duration-300 flex flex-col min-h-screen">
    <div id="page-wrapper" class="page-transition-wrapper flex-1 flex flex-col">
      <slot />
    </div>

    <script is:inline defer src="https://umami.funnel.leinss.xyz/script.js" data-website-id="7e363f6c-cc5b-4efe-9b1d-de01c1fda069"></script>

    <script is:inline>
      // Check for user preference
      if (localStorage.getItem('darkMode') === null) {
        // Check system preference
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          localStorage.setItem('darkMode', 'true');
          document.documentElement.classList.add('dark');
        } else {
          localStorage.setItem('darkMode', 'false');
        }
      }

      // Improved page transition handling
      // Apply loaded class immediately to prevent initial flash
      document.addEventListener('DOMContentLoaded', () => {
        // Mark the page as loaded on initial load
        document.documentElement.classList.add('astro-site-loaded');

        // Make sure the page wrapper is visible immediately
        const pageWrapper = document.getElementById('page-wrapper');
        if (pageWrapper) {
          pageWrapper.classList.add('page-loaded');
        }
      });

      // Handle page transitions
      document.addEventListener('astro:page-load', () => {
        // This runs on initial page load and after each navigation
        const pageWrapper = document.getElementById('page-wrapper');
        if (pageWrapper) {
          // Ensure the page is visible after content swap
          pageWrapper.classList.add('page-loaded');

          // Add loaded class to all content-animate elements
          const animatedElements = document.querySelectorAll('.content-animate');
          animatedElements.forEach(el => {
            setTimeout(() => {
              el.classList.add('loaded');
            }, 50); // Small delay to ensure DOM is ready
          });
        }
      });

      // Use before-preparation instead of before-swap to start transition earlier
      document.addEventListener('astro:before-preparation', () => {
        // This runs before navigation starts
        const pageWrapper = document.getElementById('page-wrapper');
        if (pageWrapper) {
          pageWrapper.classList.add('page-transitioning');
          pageWrapper.classList.remove('page-loaded');

          // Remove loaded class from all content-animate elements
          const animatedElements = document.querySelectorAll('.content-animate');
          animatedElements.forEach(el => {
            el.classList.remove('loaded');
          });
        }
      });

      // Handle the actual swap
      document.addEventListener('astro:after-swap', () => {
        // This runs after the new page content is swapped in but before hydration
        const pageWrapper = document.getElementById('page-wrapper');
        if (pageWrapper) {
          // Remove transitioning class to allow the loaded class to take effect
          pageWrapper.classList.remove('page-transitioning');
        }
      });
    </script>
    <script is:inline>
      // Improved script loading with absolute paths and GitHub Pages compatibility
      document.addEventListener('astro:page-load', () => {
        // Create and append script elements
        const scripts = ['transitions.js'];
        scripts.forEach(script => {
          // Check if script is already loaded to prevent duplicates
          const existingScript = document.querySelector(`script[src*="${script}"]`);
          if (!existingScript) {
            const scriptEl = document.createElement('script');

            // Use the correct path based on the current URL
            const pathname = window.location.pathname;

            // Determine if we're on a subpage
            const isSubpage = pathname.split('/').filter(Boolean).length > 0;

            // Create the correct script URL
            let scriptPath;
            if (isSubpage) {
              // Count directory levels to determine relative path
              const segments = pathname.split('/').filter(Boolean);
              scriptPath = '../'.repeat(segments.length) + 'scripts/' + script;
            } else {
              scriptPath = '/scripts/' + script;
            }

            scriptEl.src = scriptPath;
            scriptEl.async = false; // Load synchronously to ensure transitions work
            document.body.appendChild(scriptEl);
          }
        });
      }, { once: false }); // Run on every page load, not just the first
    </script>
  </body>
</html>
