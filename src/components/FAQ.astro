---
import i18n from "../assets/i18n.json"
import config from "../assets/config.ts"
import { faqPageSchema } from "../assets/schema.ts"

interface Props {
  lang: "en" | "de";
}

// Get language from props
const { lang } = Astro.props;
const t = i18n[lang]

// FAQPage JSON-LD — built from the same keys rendered below, so structured
// data always matches the visible accordion (Google requirement) and stays
// extractable for AI answer engines.
const faqSchema = faqPageSchema(t.faq as Record<string, string>)

interface FAQItem {
  questionKey: string;
  answerKey: string;
  id: string;
  question: string;
  answer: string;
}

// Create question keys instead of actual text
const questionKeys = Object.keys(t.faq)
  .filter(key => key.startsWith('q_'));

const questions: FAQItem[] = questionKeys.map(key => {
  const index = key.substring(2); // Extract number from 'q_1'
  const answerKey = `a_${index}`;
  return {
    questionKey: key,
    answerKey: answerKey,
    id: `faq-${index}`,
    question: t.faq[key as keyof typeof t.faq],
    answer: t.faq[answerKey as keyof typeof t.faq]
  };
});
---

<section id="faq" class="py-12 md:py-20 bg-white dark:bg-secondary-950">
  <div class="container-custom">
    <div class="text-center max-w-3xl mx-auto reveal">
      <span class="inline-block px-3 sm:px-4 py-1 rounded-full bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-300 font-medium text-xs sm:text-sm mb-6">
        {t.faq.tag}
      </span>
      <h2 class="mb-6 text-gray-900 dark:text-white language-content" data-key-de="title" data-key-en="title">{t.faq.title}</h2>
      <p class="mb-6 text-lg md:text-xl text-gray-600 dark:text-gray-300 language-content" data-key-de="subtitle" data-key-en="subtitle">
        {t.faq.subtitle}
      </p>
    </div>

    <!-- FAQ Accordion -->
    <div class="max-w-3xl mx-auto reveal-stagger">
      {questions.map((item) => (
        <div class="mb-6 border-b border-gray-200 dark:border-gray-800 pb-6">
          <div x-data="{ open: false }" class="relative">
            <button
              @click="open = !open"
              class="flex justify-between items-center w-full text-left focus:outline-hidden"
            >
              <span class="text-base sm:text-lg md:text-xl font-medium">
                {item.question}
              </span>
              <span class="ml-6 shrink-0">
                <svg
                  class="h-6 w-6 text-primary-600 dark:text-primary-400 transition-transform"
                  :class="{ 'rotate-180': open }"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>
              </span>
            </button>
            <div
              x-show="open"
              x-transition:enter="transition ease-out duration-200"
              x-transition:enter-start="opacity-0 -translate-y-4"
              x-transition:enter-end="opacity-100 translate-y-0"
              x-transition:leave="transition ease-in duration-150"
              x-transition:leave-start="opacity-100 translate-y-0"
              x-transition:leave-end="opacity-0 -translate-y-4"
              class="mt-4"
            >
              <div class="text-sm sm:text-base md:text-lg text-gray-600 dark:text-gray-300 whitespace-pre-line">
                {item.answer}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-12">
      <a
        href={lang === "de" ? config.external_links.strategy_call_de : config.external_links.strategy_call_en}
        class="btn-cta"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.hero.cta}
      </a>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />