---
import config from '../assets/config.ts';
import DemoLeadGate from './DemoLeadGate.astro';

interface Props {
  lang?: 'de' | 'en';
}
const { lang = 'de' } = Astro.props;
const isDE = lang === 'de';

const WEBHOOK_URL = 'https://n8n.funnel.leinss.xyz/webhook/faq-assistent';
const calUrl = isDE ? config.external_links.strategy_call_de : config.external_links.strategy_call_en;

// Abort the request after this long; the displayed hint is ~30-60 s, so allow headroom.
const TIMEOUT_MS = 90000;

// Canned fallback shown when the live endpoint is unreachable (timeout/network/offline).
const SAMPLE = {
  success: true,
  answer: isDE
    ? 'Eine Automatisierungsberatung startet mit einem kostenlosen Strategiegespräch (ca. 30 Min.). Danach erhalten Sie ein Festpreisangebot oder eine projektbasierte Kalkulation, je nach Umfang. Typische Einstiegsprojekte liegen im niedrigen vierstelligen Bereich.'
    : 'Automation consulting starts with a free 30-minute strategy call. You then get a fixed-price quote or a project-based estimate, depending on scope. Typical entry projects start in the low four-figure range.',
  confidence: 0.88,
  sources: isDE ? ['Leistungen', 'FAQ', 'Preise'] : ['Services', 'FAQ', 'Pricing'],
  escalate: false,
};

const t = {
  title: isDE ? 'Live-Demo: FAQ-Assistent' : 'Live Demo: FAQ Assistant',
  subtitle: isDE
    ? 'Stellen Sie eine Frage, die KI sucht in der Wissensbasis und antwortet mit Quellenangabe.'
    : 'Ask a question: the AI searches the knowledge base and answers with source references.',
  sampleLabel: isDE ? 'Beispielfragen:' : 'Sample questions:',
  samples: isDE
    ? ['Was kostet eine Automatisierungsberatung?', 'Welche Tools setzen Sie ein?', 'Wie lange dauert ein Projekt?', 'Ist n8n DSGVO-konform?']
    : ['What does automation consulting cost?', 'Which tools do you use?', 'How long does a project take?', 'Is n8n GDPR-compliant?'],
  placeholder: isDE ? 'Ihre Frage eingeben…' : 'Enter your question…',
  submit: isDE ? 'Fragen →' : 'Ask →',
  loading: isDE ? 'Suche in Wissensbasis…' : 'Searching knowledge base…',
  loadingHint: isDE ? '~30-60 Sekunden' : '~30-60 seconds',
  answerTitle: isDE ? 'Antwort' : 'Answer',
  sourcesLabel: isDE ? 'Quellen' : 'Sources',
  confidenceLabel: isDE ? 'Konfidenz' : 'Confidence',
  escalateMsg: isDE
    ? 'Diese Frage liegt außerhalb meiner Wissensbasis. Bitte kontaktieren Sie uns direkt.'
    : 'This question falls outside my knowledge base. Please contact us directly.',
  tryAnother: isDE ? 'Weitere Frage stellen' : 'Ask another question',
  privacy: isDE
    ? '🔒 Ihre Frage wird verarbeitet und danach nicht gespeichert.'
    : '🔒 Your question is processed and not stored afterward.',
  selfHosted: isDE
    ? '⚙️ Kein Mock-up: Ihre Frage läuft durch selbst gehostetes n8n auf Infrastruktur in der EU, die ich selbst betreibe, nicht durch einen gemieteten Cloud-Dienst.'
    : '⚙️ Not a mock-up: your question runs through self-hosted n8n on infrastructure I host and control in the EU, not a rented cloud service.',
  errorGeneric: isDE ? 'Verarbeitung fehlgeschlagen. Bitte erneut versuchen.' : 'Processing failed. Please try again.',
  rateLimited: isDE
    ? 'Tageslimit der Live-Demo erreicht. Bitte morgen wieder versuchen, oder direkt Kontakt aufnehmen.'
    : 'Live-demo daily limit reached. Please try again tomorrow: or get in touch directly.',
  errorEmpty: isDE ? 'Bitte stellen Sie eine Frage.' : 'Please enter a question.',
  offlineBadge: isDE
    ? '⚡ Live-Demo gerade offline, dies ist eine Beispielausgabe.'
    : '⚡ Live demo temporarily offline. This is sample output.',
  offlineCta: isDE ? 'Live-Demo im Gespräch ansehen →' : 'See it live: book a call →',
  artifactLabel: isDE ? 'das vollständige Antwort-Paket (.md)' : 'the full answer pack (.md)',
  // Headers for the downloadable take-home answer pack.
  fileTitle: isDE ? 'FAQ-Antwort-Paket' : 'FAQ Answer Pack',
  fileQuestion: isDE ? 'Frage' : 'Question',
  fileFooter: isDE
    ? 'Beantwortet mit der Live-Demo auf leinss-consulting.de, selbst gehostetes n8n + RAG-LLM über die Wissensbasis. Workflow-Vorlage: auf Anfrage im Erstgespräch.'
    : 'Answered with the live demo on leinss-consulting.de, self-hosted n8n + RAG LLM over the knowledge base. Workflow blueprint: on request during the intro call.',
};
---

<div id="faq-demo" class="mt-12 p-6 md:p-8 bg-white dark:bg-secondary-800/50 border border-secondary-200 dark:border-secondary-700 rounded-2xl not-prose">
  <div class="flex items-center gap-3 mb-2">
    <span class="flex items-center justify-center w-8 h-8 rounded-full bg-violet-100 dark:bg-violet-900/30 text-violet-600 dark:text-violet-400">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </span>
    <h3 class="text-lg font-bold text-secondary-900 dark:text-white">{t.title}</h3>
  </div>
  <p class="text-secondary-700 dark:text-secondary-400 text-sm mb-6">{t.subtitle}</p>

  <div class="mb-4">
    <p class="text-xs font-medium text-secondary-700 dark:text-secondary-400 mb-2">{t.sampleLabel}</p>
    <div class="flex flex-wrap gap-2">
      {t.samples.map(q => (
        <button type="button" data-sample={q}
          class="faq-sample-btn text-xs px-3 py-1.5 rounded-full border border-violet-200 dark:border-violet-700 text-violet-700 dark:text-violet-300 bg-violet-50 dark:bg-violet-900/20 hover:bg-violet-100 dark:hover:bg-violet-900/40 transition-colors cursor-pointer">
          {q}
        </button>
      ))}
    </div>
  </div>

  <div id="faq-input-area">
    <div class="flex gap-2">
      <input type="text" id="faq-question" maxlength="500"
        placeholder={t.placeholder}
        class="flex-1 px-4 py-2.5 text-sm rounded-xl border border-secondary-300 dark:border-secondary-600 bg-white dark:bg-secondary-800 text-secondary-900 dark:text-white placeholder-secondary-400 focus:outline-hidden focus:ring-2 focus:ring-violet-500 focus:border-transparent" />
      <button id="faq-submit"
        class="px-5 py-2.5 bg-violet-600 hover:bg-violet-700 text-white text-sm font-medium rounded-xl transition-colors whitespace-nowrap">
        {t.submit}
      </button>
    </div>
    <p id="faq-error" class="hidden mt-2 text-sm text-red-600 dark:text-red-400"></p>
  </div>

  <div id="faq-loading" class="hidden mt-6 text-center py-8">
    <div class="inline-flex items-center gap-3 text-secondary-700 dark:text-secondary-400">
      <svg class="animate-spin w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span class="text-sm">{t.loading} <span class="text-xs text-secondary-400">({t.loadingHint})</span></span>
    </div>
  </div>

  <div id="faq-result" class="hidden mt-6">
    <div id="faq-offline" class="hidden mb-4 p-3 rounded-xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700 text-xs text-amber-800 dark:text-amber-300">
      {t.offlineBadge}
    </div>
    <div id="faq-escalate" class="hidden mb-4 p-4 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700 rounded-xl">
      <p class="text-sm text-amber-800 dark:text-amber-300 flex items-start gap-2">
        <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        {t.escalateMsg}
      </p>
    </div>

    <div class="p-5 bg-secondary-50 dark:bg-secondary-900/50 rounded-xl border border-secondary-200 dark:border-secondary-700">
      <p class="text-xs font-semibold text-secondary-400 dark:text-secondary-500 uppercase tracking-wider mb-2">{t.answerTitle}</p>
      <p id="faq-answer-text" class="text-sm text-secondary-800 dark:text-secondary-200 leading-relaxed"></p>
    </div>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
      <div id="faq-sources-row" class="hidden flex items-center gap-2 flex-wrap">
        <span class="text-xs text-secondary-400">{t.sourcesLabel}:</span>
        <div id="faq-sources-list" class="flex gap-1 flex-wrap"></div>
      </div>
      <div class="flex items-center gap-2 ml-auto">
        <span class="text-xs text-secondary-400">{t.confidenceLabel}:</span>
        <div class="w-24 h-2 bg-secondary-200 dark:bg-secondary-700 rounded-full overflow-hidden">
          <div id="faq-conf-bar" class="h-full rounded-full transition-all duration-500" style="width: 0%"></div>
        </div>
        <span id="faq-conf-pct" class="text-xs font-medium text-secondary-700 dark:text-secondary-300 w-8 text-right"></span>
      </div>
    </div>

    <div class="mt-5 flex flex-wrap items-center gap-4">
      <button id="faq-reset"
        class="text-sm text-violet-600 dark:text-violet-400 hover:underline">
        ← {t.tryAnother}
      </button>
      <a id="faq-offline-cta" href="" target="_blank" rel="noopener noreferrer"
        class="hidden inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg bg-violet-600 hover:bg-violet-700 text-white transition-colors">
        {t.offlineCta}
      </a>
    </div>

    <DemoLeadGate lang={lang} id="faq" artifactLabel={t.artifactLabel} />
  </div>

  <p class="mt-4 text-xs text-secondary-400 dark:text-secondary-500">{t.privacy}</p>
  <p class="mt-1 text-xs font-medium text-secondary-700 dark:text-secondary-400">{t.selfHosted}</p>
</div>

<script define:vars={{ WEBHOOK_URL, t, lang, calUrl, SAMPLE, TIMEOUT_MS }}>
  const questionInput = document.getElementById('faq-question');
  const submitBtn = document.getElementById('faq-submit');
  const errorEl = document.getElementById('faq-error');
  const inputArea = document.getElementById('faq-input-area');
  const loadingEl = document.getElementById('faq-loading');
  const resultEl = document.getElementById('faq-result');
  const answerText = document.getElementById('faq-answer-text');
  const confBar = document.getElementById('faq-conf-bar');
  const confPct = document.getElementById('faq-conf-pct');
  const escalateEl = document.getElementById('faq-escalate');
  const sourcesRow = document.getElementById('faq-sources-row');
  const sourcesList = document.getElementById('faq-sources-list');
  const resetBtn = document.getElementById('faq-reset');
  const offlineEl = document.getElementById('faq-offline');
  const offlineCta = document.getElementById('faq-offline-cta');

  document.querySelectorAll('.faq-sample-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      questionInput.value = btn.dataset.sample;
      questionInput.focus();
    });
  });

  questionInput.addEventListener('keydown', e => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); submitQuestion(); }
  });
  submitBtn.addEventListener('click', submitQuestion);
  resetBtn.addEventListener('click', resetForm);

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.classList.remove('hidden');
  }

  let lastQuestion = '';

  function resetForm() {
    resultEl.classList.add('hidden');
    inputArea.classList.remove('hidden');
    questionInput.value = '';
    errorEl.classList.add('hidden');
    offlineEl.classList.add('hidden');
    offlineCta.classList.add('hidden');
    document.getElementById('faq-gate')?.classList.add('hidden');
  }

  function renderResult(data) {
    answerText.textContent = data.answer || '';

    const pct = Math.round((data.confidence || 0) * 100);
    confBar.style.width = pct + '%';
    confBar.className = 'h-full rounded-full transition-all duration-500 ' +
      (pct >= 70 ? 'bg-green-500' : pct >= 45 ? 'bg-amber-500' : 'bg-red-500');
    confPct.textContent = pct + '%';

    // Clear and repopulate sources using safe DOM methods
    while (sourcesList.firstChild) sourcesList.removeChild(sourcesList.firstChild);
    if (data.sources && data.sources.length > 0) {
      data.sources.forEach(s => {
        const tag = document.createElement('span');
        tag.className = 'text-xs px-2 py-0.5 bg-violet-100 dark:bg-violet-900/30 text-violet-700 dark:text-violet-300 rounded-full';
        tag.textContent = String(s);
        sourcesList.appendChild(tag);
      });
      sourcesRow.classList.remove('hidden');
    } else {
      sourcesRow.classList.add('hidden');
    }

    escalateEl.classList.toggle('hidden', !data.escalate);
    resultEl.classList.remove('hidden');

    armGate(data, pct);
  }

  // Gate the take-home artifact: a downloadable Markdown answer pack.
  function armGate(data, pct) {
    const gateEl = document.getElementById('faq-gate');
    if (!gateEl || !window.__demoGate) return;
    const lines = [`# ${t.fileTitle}`, ''];
    lines.push(`## ${t.fileQuestion}`, '', lastQuestion || '-', '');
    lines.push(`## ${t.answerTitle}`, '', data.answer || '-', '');
    lines.push(`_${t.confidenceLabel}: ${pct}%_`, '');
    const sources = Array.isArray(data.sources) ? data.sources : [];
    if (sources.length > 0) {
      lines.push(`## ${t.sourcesLabel}`, '');
      sources.forEach((s) => lines.push(`- ${s}`));
      lines.push('');
    }
    lines.push('---', t.fileFooter, '');
    window.__demoGate.arm('faq', {
      text: lines.join('\n'),
      filename: lang === 'de' ? 'faq-antwort-paket.md' : 'faq-answer-pack.md',
      mime: 'text/markdown;charset=utf-8;',
    });
    gateEl.classList.remove('hidden');
  }

  // Endpoint unreachable (timeout/network/offline): show a canned sample + booking CTA.
  function renderFallback() {
    loadingEl.classList.add('hidden');
    renderResult(SAMPLE);
    offlineEl.classList.remove('hidden');
    offlineCta.href = calUrl;
    offlineCta.classList.remove('hidden');
  }

  async function submitQuestion() {
    const question = questionInput.value.trim();
    if (!question) { showError(t.errorEmpty); return; }
    lastQuestion = question;

    errorEl.classList.add('hidden');
    offlineEl.classList.add('hidden');
    offlineCta.classList.add('hidden');
    document.getElementById('faq-gate')?.classList.add('hidden');
    inputArea.classList.add('hidden');
    loadingEl.classList.remove('hidden');

    try {
      const res = await fetch(WEBHOOK_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question, language: lang }),
        signal: AbortSignal.timeout(TIMEOUT_MS),
      });
      const data = await res.json().catch(() => null);

      // Rate-limited by the demo gateway (per-IP burst or global daily cap).
      if (res.status === 429) {
        loadingEl.classList.add('hidden');
        inputArea.classList.remove('hidden');
        showError((data && data.message) || t.rateLimited);
        return;
      }

      // Server responded but rejected the input: show the real reason, not a sample.
      if (data && data.success === false) {
        loadingEl.classList.add('hidden');
        inputArea.classList.remove('hidden');
        showError(data.message || data.error || t.errorGeneric);
        return;
      }
      // Require a successful, well-formed answer; otherwise (non-OK / garbage 200 / missing
      // success) fall through to the sample rather than rendering a blank "Answer".
      if (!res.ok || !data || !data.success) throw new Error('HTTP ' + res.status);

      loadingEl.classList.add('hidden');
      renderResult(data);
    } catch (err) {
      console.error('[FAQAssistentDemo]', err);
      renderFallback();
    }
  }
</script>
