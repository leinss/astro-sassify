---
import i18n from "../assets/i18n.json"
import config from "../assets/config.ts"
import { BsArrowRight } from "react-icons/bs"

interface Props {
  lang: "en" | "de"
  pillar: "crm" | "documents" | "communication" | "integrations"
}

const { lang, pillar } = Astro.props
const t = i18n[lang].roi
const calUrl =
  lang === "en"
    ? config.external_links.strategy_call_en
    : config.external_links.strategy_call_de
const locale = lang === "de" ? "de-DE" : "en-US"

// Per-pillar starting points for the sliders — the visitor adjusts them to match
// their own team. `automationPct` is the share of the task that can be automated
// (a percentage), NOT an hourly rate. Conservative defaults keep the headline credible.
const defaults: Record<Props["pillar"], { hours: number; automationPct: number }> = {
  crm: { hours: 8, automationPct: 70 },
  documents: { hours: 6, automationPct: 80 },
  communication: { hours: 5, automationPct: 65 },
  integrations: { hours: 4, automationPct: 75 },
}
const d = defaults[pillar]

const WEEKS = 46 // working weeks per year (accounts for holidays and leave)
const DEFAULT_HOURLY_EUR = 50

// Server-rendered initial figures: shown before Alpine hydrates (and as a graceful
// fallback if it never does); the reactive getters take over on load.
const initialHoursSaved = Math.round(d.hours * (d.automationPct / 100) * WEEKS)
const initialSavings = initialHoursSaved * DEFAULT_HOURLY_EUR
const eur = new Intl.NumberFormat(locale, {
  style: "currency",
  currency: "EUR",
  maximumFractionDigits: 0,
})
const num = new Intl.NumberFormat(locale)
---

<section class="py-16 bg-secondary-50 dark:bg-secondary-900">
  <div class="container-custom">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10 reveal">
        <h2 class="text-3xl font-bold text-secondary-900 dark:text-white mb-3">
          {t.title}
        </h2>
        <p class="text-secondary-600 dark:text-secondary-300">{t.subtitle}</p>
      </div>

      <div
        class="rounded-2xl border border-secondary-200 dark:border-secondary-700 bg-white dark:bg-secondary-950 p-6 md:p-8 shadow-md reveal"
        x-data={`{
          hours: ${d.hours},
          cost: ${DEFAULT_HOURLY_EUR},
          automation: ${d.automationPct},
          weeks: ${WEEKS},
          get hoursSavedYear() { return Math.round(this.hours * (this.automation / 100) * this.weeks) },
          get savings() { return this.hoursSavedYear * this.cost },
          fmtEur(n) { return new Intl.NumberFormat('${locale}', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n) },
          fmtNum(n) { return new Intl.NumberFormat('${locale}').format(n) }
        }`}
      >
        <div class="grid md:grid-cols-2 gap-8 items-stretch">
          <!-- Inputs -->
          <div class="space-y-6">
            <div>
              <div class="flex justify-between items-baseline mb-2">
                <label for="roi-hours" class="text-sm font-medium text-secondary-700 dark:text-secondary-300">
                  {t.hours_label}
                </label>
                <span class="text-sm font-bold text-primary-600 dark:text-primary-400">
                  <span x-text="hours">{d.hours}</span> h
                </span>
              </div>
              <input
                id="roi-hours"
                type="range"
                min="1"
                max="40"
                step="1"
                value={d.hours}
                x-model.number="hours"
                class="roi-slider"
                aria-label={t.hours_label}
                :aria-valuetext="hours + ' h'"
              />
            </div>

            <div>
              <div class="flex justify-between items-baseline mb-2">
                <label for="roi-cost" class="text-sm font-medium text-secondary-700 dark:text-secondary-300">
                  {t.cost_label}
                </label>
                <span class="text-sm font-bold text-primary-600 dark:text-primary-400" x-text="fmtEur(cost)">{eur.format(DEFAULT_HOURLY_EUR)}</span>
              </div>
              <input
                id="roi-cost"
                type="range"
                min="20"
                max="150"
                step="5"
                value={DEFAULT_HOURLY_EUR}
                x-model.number="cost"
                class="roi-slider"
                aria-label={t.cost_label}
                :aria-valuetext="fmtEur(cost)"
              />
            </div>

            <div>
              <div class="flex justify-between items-baseline mb-2">
                <label for="roi-automation" class="text-sm font-medium text-secondary-700 dark:text-secondary-300">
                  {t.automation_label}
                </label>
                <span class="text-sm font-bold text-primary-600 dark:text-primary-400">
                  <span x-text="automation">{d.automationPct}</span> %
                </span>
              </div>
              <input
                id="roi-automation"
                type="range"
                min="10"
                max="95"
                step="5"
                value={d.automationPct}
                x-model.number="automation"
                class="roi-slider"
                aria-label={t.automation_label}
                :aria-valuetext="automation + ' %'"
              />
            </div>
          </div>

          <!-- Result -->
          <div class="rounded-xl bg-primary-50 dark:bg-primary-900/20 p-6 text-center flex flex-col justify-center">
            <p class="text-sm font-medium text-secondary-600 dark:text-secondary-400">
              {t.savings_label}
            </p>
            <p
              class="text-4xl md:text-5xl font-extrabold text-primary-600 dark:text-primary-400 my-2 tabular-nums"
              x-text="fmtEur(savings)"
            >{eur.format(initialSavings)}</p>
            <p class="text-sm text-secondary-500 dark:text-secondary-400">{t.per_year}</p>
            <div class="mt-5 pt-5 border-t border-primary-100 dark:border-primary-800">
              <p class="text-sm text-secondary-600 dark:text-secondary-400">
                {t.hours_saved_label}
              </p>
              <p class="text-2xl font-bold text-secondary-900 dark:text-white tabular-nums">
                <span x-text="fmtNum(hoursSavedYear)">{num.format(initialHoursSaved)}</span> h
              </p>
            </div>
          </div>
        </div>

        <p class="mt-6 text-xs text-secondary-500 dark:text-secondary-400 text-center">
          {t.disclaimer}
        </p>

        <div class="mt-6 text-center">
          <a
            href={calUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary inline-flex items-center gap-2"
            data-umami-event="roi-cta"
            data-umami-event-pillar={pillar}
          >
            {t.cta}
            <BsArrowRight className="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .roi-slider {
    width: 100%;
    height: 0.4rem;
    cursor: pointer;
    accent-color: var(--color-primary-500);
  }
</style>
