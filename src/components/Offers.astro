---
import config from '../assets/config.ts';
import i18n from '../assets/i18n.json';
import { BsCheckCircleFill, BsArrowRight } from 'react-icons/bs';

interface Props {
  lang: 'en' | 'de';
}

const { lang } = Astro.props;
const t = i18n[lang].services.offers;
const callUrl =
  lang === 'de'
    ? config.external_links.strategy_call_de
    : config.external_links.strategy_call_en;
---

<section class="py-20 bg-secondary-50 dark:bg-secondary-950">
  <div class="container-custom">
    <div class="max-w-3xl mx-auto text-center mb-14 reveal">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary-600 dark:text-primary-400 mb-3">
        {t.eyebrow}
      </p>
      <h2 class="text-3xl md:text-4xl font-bold text-secondary-900 dark:text-white mb-4">
        {t.title}
      </h2>
      <p class="text-lg text-secondary-600 dark:text-secondary-300">
        {t.subtitle}
      </p>
    </div>

    <div class="grid lg:grid-cols-3 gap-8 reveal-stagger">
      {t.packages.map((pkg: any) => (
        <div class="flex flex-col h-full bg-white dark:bg-secondary-900 rounded-xl border border-secondary-200 dark:border-secondary-800 shadow-md p-8">
          {/* Optional. Marks the lowest-commitment package as the way in for
              someone who is not ready to buy a build yet. The row is reserved
              on every card, badge or not, so the three headings stay aligned. */}
          <div class="h-6 mb-3">
            {pkg.badge && (
              <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide bg-primary-100 text-primary-700 dark:bg-primary-900 dark:text-primary-300">
                {pkg.badge}
              </span>
            )}
          </div>
          <h3 class="text-xl font-bold text-secondary-900 dark:text-white mb-2">
            {pkg.name}
          </h3>
          <p class="text-secondary-600 dark:text-secondary-300 mb-6">
            {pkg.tagline}
          </p>
          {pkg.example && (
            <p class="text-sm sm:text-base italic text-secondary-500 dark:text-secondary-400 mb-6">
              {pkg.example}
            </p>
          )}
          <div class="flex items-baseline gap-2 mb-1">
            <span class="text-2xl font-bold text-primary-600 dark:text-primary-400">
              {t.price_on_request}
            </span>
          </div>
          <p class="text-sm sm:text-base text-secondary-500 dark:text-secondary-400 mb-6">
            {t.timeline_label}: {pkg.timeline}
          </p>
          <p class="text-sm sm:text-base font-semibold text-secondary-700 dark:text-secondary-300 mb-3">
            {t.includes_label}
          </p>
          <ul class="space-y-3 mb-8 grow">
            {pkg.includes.map((item: string) => (
              <li class="flex items-start gap-3">
                <span class="text-primary-600 dark:text-primary-400 mt-0.5 shrink-0">
                  <BsCheckCircleFill className="w-4 h-4" />
                </span>
                <span class="text-secondary-700 dark:text-secondary-300 text-sm sm:text-base">
                  {item}
                </span>
              </li>
            ))}
          </ul>
          <a
            href={callUrl}
            class="btn-cta w-full inline-flex items-center justify-center gap-2 mt-auto"
            target="_blank"
            rel="noopener noreferrer"
          >
            {i18n[lang].hero.cta}
            <BsArrowRight className="w-4 h-4" />
          </a>
        </div>
      ))}
    </div>

    <p class="text-center text-sm text-secondary-500 dark:text-secondary-400 mt-8">
      {t.net_note}
    </p>
    <p class="text-center text-base text-secondary-700 dark:text-secondary-300 mt-2">
      {t.cta_label}
    </p>
  </div>
</section>
