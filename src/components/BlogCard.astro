---
import type { CollectionEntry } from "astro:content"
import { Image } from "astro:assets"
import i18n from "../assets/i18n.json"
import { BsArrowRight } from "react-icons/bs"
import { blogImages } from "../assets/blogImages.ts"

interface Props {
  post: CollectionEntry<"blog">
  lang: "en" | "de"
}

const { post, lang } = Astro.props
const t = i18n[lang]

const basePath = lang === "en" ? "/en" : "/de"

// Strip the language folder prefix from the slug (e.g., "en/my-post" -> "my-post")
const cleanSlug = post.id.replace(/^(en|de)\//, "")

// Format date based on language
const formattedDate = post.data.pubDate.toLocaleDateString(
  lang === "de" ? "de-DE" : "en-US",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
  }
)

// Category labels
const categoryLabels: Record<string, Record<string, string>> = {
  automation: { en: "Automation", de: "Automatisierung" },
  integration: { en: "Integration", de: "Integration" },
  crm: { en: "CRM & Sales", de: "CRM & Vertrieb" },
  documents: { en: "Documents", de: "Dokumente" },
  communication: { en: "Communication", de: "Kommunikation" },
  "reference-build": { en: "Reference Build", de: "Referenz-Build" },
  "case-study": { en: "Case Study", de: "Fallstudie" },
}

// Default placeholder image if no heroImage
const heroImagePath = post.data.heroImage || "/images/blog/placeholder.png"
const optimizedImage = blogImages[heroImagePath]
---

<a
  href={`${basePath}/blog/${cleanSlug}/`}
  class="group block bg-secondary-50 dark:bg-secondary-900 rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover-lift"
>
  <!-- Hero Image -->
  <div class="aspect-video relative overflow-hidden">
    {optimizedImage ? (
      <Image
        src={optimizedImage}
        alt={post.data.title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
        widths={[400, 600, 800]}
        sizes="(max-width: 640px) 400px, (max-width: 1024px) 600px, 800px"
      />
    ) : (
      <img
        src={heroImagePath}
        alt={post.data.title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
    )}
    <!-- Category Badge overlay -->
    <div class="absolute top-4 left-4">
      <span class="px-3 py-1 text-xs font-medium rounded-full bg-primary-500/90 text-white backdrop-blur-xs">
        {categoryLabels[post.data.category]?.[lang] || post.data.category}
      </span>
    </div>
  </div>

  <!-- Content -->
  <div class="p-6">
    <h3 class="text-xl font-bold text-secondary-900 dark:text-white mb-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors line-clamp-2">
      {post.data.title}
    </h3>

    <p class="text-secondary-700 dark:text-secondary-300 mb-4 line-clamp-3">
      {post.data.description}
    </p>

    <!-- Meta -->
    <div class="flex items-center justify-between">
      <time datetime={post.data.pubDate.toISOString()} class="text-sm text-secondary-500 dark:text-secondary-400">
        {formattedDate}
      </time>

      <span class="inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 font-medium group-hover:gap-3 transition-all">
        {lang === "de" ? "Lesen" : "Read"}
        <BsArrowRight className="w-4 h-4" />
      </span>
    </div>
  </div>
</a>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hover-lift {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .hover-lift:hover {
    transform: translateY(-4px);
  }
</style>
