---
import { IoLanguage } from "react-icons/io5"
import i18n from "../assets/i18n.json"

// Get the current URL path and hash
const { pathname, hash } = Astro.url

// Function to get the equivalent URL in another language
function getLocalizedPath(targetLang: string) {
  // If we're on the default locale (de) with no prefix
  if (!pathname.startsWith("/en") && targetLang === "en") {
    return `/en${pathname}${hash}`
  }

  // If we're on the English version and want to go to default (German)
  if (pathname.startsWith("/en") && targetLang === "de") {
    return `${pathname.replace(/^\/en/, "")}${hash}`
  }

  // Return current path if something unexpected
  return `${pathname}${hash}`
}

// Get the paths for each language
const dePath = getLocalizedPath("de")
const enPath = getLocalizedPath("en")

// Determine current language
const currentLang = pathname.startsWith("/en") ? "en" : "de"

// Get translations
const t = i18n[currentLang]

// Get the other language
const otherLang = currentLang === "en" ? "de" : "en"
---

<a
  href={currentLang === "en" ? dePath : enPath}
  class="language-switcher focus:outline-none focus:ring-2 focus:ring-primary-500 rounded-full text-secondary-500 hover:text-secondary-700 dark:text-secondary-400 dark:hover:text-secondary-200"
  aria-label={t.header.switch_language}
>
  <IoLanguage className="lang-icon" />
  <div class="lang-stack">
    <span class="current-lang">{currentLang.toUpperCase()}</span>
    <span class="other-lang">{otherLang.toUpperCase()}</span>
  </div>
</a>

<style>
  .language-switcher {
    display: flex;
    align-items: center;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  /* Base styles for all language switchers */
  .language-switcher {
    padding: 0.5rem;
    width: auto;
    justify-content: center;
    background: transparent;
    border: none;
  }

  /* Hover styles are now handled by Tailwind classes */

  .lang-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: currentColor;
  }

  .lang-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.1;
  }

  .current-lang {
    font-weight: bold;
    font-size: 0.875rem;
    color: currentColor;
  }

  .other-lang {
    font-size: 0.75rem;
    color: var(--text-primary-600, #0891b2);
    transition: all 0.2s ease;
    transform-origin: center;
  }

  :global(.dark) .other-lang {
    color: var(--text-primary-400, #22d3ee);
  }

  .language-switcher:hover .other-lang {
    transform: scale(1.1);
  }
</style>
