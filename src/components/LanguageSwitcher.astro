---
import { IoLanguage } from "react-icons/io5"
import i18n from "../assets/i18n.json"

interface Props {
  lang: "en" | "de";
}

// Get the current URL path and hash
const { pathname, hash } = Astro.url

// Function to get the equivalent URL in another language
function getLocalizedPath(targetLang: string) {
  // If we're on the German version and want to go to English
  if (pathname.includes("/ki-kommunikation") && targetLang === "en") {
    return pathname.replace("/ki-kommunikation", "/ai-communication") + hash
  }

  // If we're on the English version and want to go to German
  if (pathname.includes("/ai-communication") && targetLang === "de") {
    return pathname.replace("/ai-communication", "/ki-kommunikation") + hash
  }

  // Handle root redirects
  if (pathname === "/" && targetLang === "de") {
    return "/ki-kommunikation" + hash
  }
  if (pathname === "/" && targetLang === "en") {
    return "/ai-communication" + hash
  }
  if (pathname === "/en" && targetLang === "en") {
    return "/ai-communication" + hash
  }
  if (pathname === "/en" && targetLang === "de") {
    return "/ki-kommunikation" + hash
  }

  // Return current path if something unexpected
  return `${pathname}${hash}`
}

// Get the paths for each language
const dePath = getLocalizedPath("de")
const enPath = getLocalizedPath("en")

// Get language from props
const { lang } = Astro.props;

// Get translations
const t = i18n[lang]

// Get the other language
const otherLang = lang === "en" ? "de" : "en"
---

<a
  href={lang === "en" ? dePath : enPath}
  class="language-switcher focus:outline-none focus:ring-2 focus:ring-primary-500 rounded-full text-secondary-500 hover:text-secondary-700 dark:text-secondary-400 dark:hover:text-secondary-200"
  aria-label={t.header.switch_language}
>
  <IoLanguage className="lang-icon" />
  <div class="lang-stack">
    <span class="current-lang">{lang.toUpperCase()}</span>
    <span class="other-lang">{otherLang.toUpperCase()}</span>
  </div>
</a>

<style>
  .language-switcher {
    display: flex;
    align-items: center;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  /* Base styles for all language switchers */
  .language-switcher {
    padding: 0.5rem;
    width: auto;
    justify-content: center;
    background: transparent;
    border: none;
  }

  /* Hover styles are now handled by Tailwind classes */

  .lang-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: currentColor;
  }

  .lang-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.1;
  }

  .current-lang {
    font-weight: bold;
    font-size: 0.875rem;
    color: currentColor;
  }

  .other-lang {
    font-size: 0.75rem;
    color: var(--text-primary-600, #0891b2);
    transition: all 0.2s ease;
    transform-origin: center;
  }

  :global(.dark) .other-lang {
    color: var(--text-primary-400, #22d3ee);
  }

  .language-switcher:hover .other-lang {
    transform: scale(1.1);
  }
</style>
