---
import { IoLanguage } from "react-icons/io5"
import i18n from "../assets/i18n.json"

interface Props {
  lang: "en" | "de"
  alternateHref?: string // Used for blog posts with different slugs per language
}

// Get the current URL path and hash
const { pathname, hash } = Astro.url

// Function to get the equivalent URL in another language
function getLocalizedPath(targetLang: string) {
  // Define page name mappings between languages
  const pageNameMappings = {
    // English to German
    "privacy-policy": "datenschutzerklaerung",
    imprint: "impressum",

    // German to English
    datenschutzerklaerung: "privacy-policy",
    impressum: "imprint",
  }

  // If we're on the German version and want to go to English
  if (pathname.startsWith("/de") && targetLang === "en") {
    // First replace the base path
    let newPath = pathname.replace("/de", "/en")

    // Check if we need to translate a specific page name
    for (const [dePage, enPage] of Object.entries(pageNameMappings)) {
      if (newPath.includes(`/${dePage}`)) {
        newPath = newPath.replace(`/${dePage}`, `/${enPage}`)
      }
    }

    return newPath + hash
  }

  // If we're on the English version and want to go to German
  if (pathname.startsWith("/en") && targetLang === "de") {
    // First replace the base path
    let newPath = pathname.replace("/en", "/de")

    // Check if we need to translate a specific page name
    // We need to reverse the mapping for English to German
    const reversedMappings: Record<string, string> = {}
    for (const [key, value] of Object.entries(pageNameMappings)) {
      reversedMappings[value] = key
    }

    for (const [enPage, dePage] of Object.entries(reversedMappings)) {
      if (newPath.includes(`/${enPage}`)) {
        newPath = newPath.replace(`/${enPage}`, `/${dePage}`)
      }
    }

    return newPath + hash
  }

  // Handle root redirects
  if (pathname === "/") {
    return (targetLang === "de" ? "/de" : "/en") + hash
  }

  // Return current path if something unexpected
  return `${pathname}${hash}`
}

// Get the paths for each language
const dePath = getLocalizedPath("de")
const enPath = getLocalizedPath("en")

// Get language from props
const { lang, alternateHref } = Astro.props

// Get translations
const t = i18n[lang]

// Get the other language
const otherLang = lang === "en" ? "de" : "en"
---

<a
  href={alternateHref || (lang === "en" ? dePath : enPath)}
  class="language-switcher focus:outline-hidden focus:ring-2 focus:ring-primary-500 rounded-full text-secondary-500 hover:text-secondary-700 dark:text-secondary-400 dark:hover:text-secondary-200"
  aria-label={t.header.switch_language}
>
  <IoLanguage className="lang-icon" />
  <div class="lang-stack">
    <span class="current-lang">{lang.toUpperCase()}</span>
    <span class="other-lang">{otherLang.toUpperCase()}</span>
  </div>
</a>

<style>
  .language-switcher {
    display: flex;
    align-items: center;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  /* Base styles for all language switchers */
  .language-switcher {
    padding: 0.5rem;
    width: auto;
    justify-content: center;
    background: transparent;
    border: none;
  }

  /* Hover styles are now handled by Tailwind classes */

  .lang-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: currentColor;
  }

  .lang-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.1;
  }

  .current-lang {
    font-weight: bold;
    font-size: 0.875rem;
    color: currentColor;
  }

  .other-lang {
    font-size: 0.75rem;
    color: var(--text-primary-600, #0891b2);
    transition: all 0.2s ease;
    transform-origin: center;
  }

  :global(.dark) .other-lang {
    color: var(--text-primary-400, #22d3ee);
  }

  .language-switcher:hover .other-lang {
    transform: scale(1.1);
  }
</style>
