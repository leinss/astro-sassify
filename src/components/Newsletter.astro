---
import i18n from "../assets/i18n.json"

interface Props {
  lang: "en" | "de"
}

const { lang } = Astro.props
const t = i18n[lang]

const basePath = lang === "en" ? "/en" : "/de"

// Listmonk public subscription config
const LISTMONK_URL = "https://newsletter.funnel.leinss.xyz"
const LIST_UUID = "56525a08-c916-4c7c-ae2c-36481da13071"
---

<section id="newsletter" class="section relative overflow-hidden bg-linear-to-b from-primary-100 to-white dark:from-primary-950 dark:to-secondary-950">
  <div class="absolute inset-0 z-0 opacity-30">
    <div class="absolute inset-0 bg-grid-pattern"></div>
  </div>
  <div class="container-custom max-w-4xl relative z-10">
    <div class="card p-8 md:p-12 border border-primary-200/50 dark:border-primary-800/30 bg-white/80 dark:bg-secondary-900/80 backdrop-blur-xs">
      <div class="text-center mb-8">
        <h2 class="mb-4 text-secondary-900 dark:text-white">{t.newsletter.title}</h2>
        <p class="text-secondary-700 dark:text-secondary-300 max-w-2xl mx-auto">
          {t.newsletter.subtitle}
        </p>
      </div>

      <form
        class="max-w-xl mx-auto"
        x-data={`{
          email: '',
          website: '',
          loadedAt: Date.now(),
          loading: false,
          submitted: false,
          success: false,
          message: ''
        }`}
        @submit.prevent={`
          if (loading) return;

          // Spam protection: a filled honeypot or a sub-2s submit is a bot.
          // No-op silently (mimic success, send no request to Listmonk).
          if (website || (Date.now() - loadedAt) < 2000) {
            submitted = true;
            success = true;
            message = '${lang === "de" ? "Vielen Dank! Bitte bestätigen Sie Ihre Anmeldung in der E-Mail, die wir Ihnen gesendet haben." : "Thank you! Please confirm your subscription in the email we sent you."}';
            return;
          }

          if (!email) {
            message = '${lang === "de" ? "Bitte geben Sie Ihre E-Mail-Adresse ein." : "Please enter your email address."}';
            return;
          }
          if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {
            message = '${lang === "de" ? "Bitte geben Sie eine gültige E-Mail-Adresse ein." : "Please enter a valid email address."}';
            return;
          }

          loading = true;
          message = '';

          fetch('${LISTMONK_URL}/api/public/subscription', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: email,
              list_uuids: ['${LIST_UUID}']
            })
          })
          .then(res => {
            if (res.ok) {
              return { success: true };
            }
            return res.json().then(data => ({ success: false, error: data.message || 'Unknown error' }));
          })
          .then(data => {
            loading = false;
            submitted = true;
            success = data.success;
            if (data.success) {
              message = '${lang === "de" ? "Vielen Dank! Bitte bestätigen Sie Ihre Anmeldung in der E-Mail, die wir Ihnen gesendet haben." : "Thank you! Please confirm your subscription in the email we sent you."}';
            } else if (data.error && data.error.includes('already')) {
              success = true;
              message = '${lang === "de" ? "Diese E-Mail-Adresse ist bereits angemeldet." : "This email is already subscribed."}';
            } else {
              message = '${lang === "de" ? "Ein Fehler ist aufgetreten. Bitte versuchen Sie es später erneut." : "An error occurred. Please try again later."}';
            }
          })
          .catch(() => {
            loading = false;
            message = '${t.newsletter.error_message}';
          });
        `}
      >
        <!-- Honeypot: hidden from humans; bots that fill it are silently rejected. -->
        <div aria-hidden="true" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden">
          <label for="newsletter-website">Website (leave blank)</label>
          <input
            type="text"
            id="newsletter-website"
            name="website"
            x-model="website"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <!-- Form Input -->
        <div x-show="!submitted" x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0">
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="grow">
              <label for="newsletter-email" class="sr-only">{t.newsletter.placeholder}</label>
              <input
                type="email"
                id="newsletter-email"
                x-model="email"
                placeholder={t.newsletter.placeholder}
                class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-secondary-600 bg-white dark:bg-secondary-800 text-secondary-900 dark:text-white placeholder-gray-400 dark:placeholder-secondary-500 focus:outline-hidden focus:ring-2 focus:ring-primary-500 dark:focus:ring-primary-400 transition-all"
                :disabled="loading"
                required
              />
            </div>
            <button
              type="submit"
              class="btn-primary whitespace-nowrap flex items-center justify-center gap-2 min-w-[140px]"
              :disabled="loading"
              :class="{ 'opacity-70 cursor-wait': loading }"
            >
              <svg x-show="loading" class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span x-text={`loading ? '' : '${t.newsletter.button}'`}>{t.newsletter.button}</span>
            </button>
          </div>
          <p class="text-red-500 dark:text-red-400 text-sm mt-2" x-show="message && !submitted" x-text="message"></p>
        </div>

        <!-- Success/Error Message -->
        <div
          x-show="submitted"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 transform scale-95"
          x-transition:enter-end="opacity-100 transform scale-100"
          class="text-center p-6 rounded-lg"
          :class="success ? 'bg-primary-50 dark:bg-primary-900/30' : 'bg-red-50 dark:bg-red-900/30'"
          x-cloak
        >
          <!-- Success Icon -->
          <svg x-show="success" class="w-12 h-12 text-primary-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <!-- Error Icon -->
          <svg x-show="!success" class="w-12 h-12 text-red-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <h3
            class="text-xl font-semibold mb-2"
            :class="success ? 'text-secondary-900 dark:text-white' : 'text-red-700 dark:text-red-400'"
            x-text={`success ? '${t.newsletter.success_title}' : '${lang === "de" ? "Fehler" : "Error"}'`}
          ></h3>
          <p
            class="mb-4"
            :class="success ? 'text-secondary-600 dark:text-secondary-300' : 'text-red-600 dark:text-red-400'"
            x-text="message"
          ></p>
          <button
            x-show="!success"
            type="button"
            @click="submitted = false; message = ''"
            class="text-primary-600 dark:text-primary-400 hover:underline font-medium"
          >
            {lang === "de" ? "Erneut versuchen" : "Try again"}
          </button>
        </div>
      </form>

      <div class="mt-6 text-center text-sm text-secondary-700 dark:text-secondary-400">
        {t.newsletter.privacy_note}{" "}
        <a href={`${basePath}/${lang === "de" ? "datenschutzerklaerung" : "privacy-policy"}`} class="text-primary-600 dark:text-primary-400 hover:underline">
          {lang === "de" ? "Datenschutzerklärung" : "Privacy Policy"}
        </a>.
      </div>
    </div>
  </div>
</section>
