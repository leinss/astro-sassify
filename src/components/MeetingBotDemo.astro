---
import config from '../assets/config.ts';

interface Props {
  lang?: 'de' | 'en';
}
const { lang = 'de' } = Astro.props;
const isDE = lang === 'de';

const WEBHOOK_URL = 'https://n8n.esprimo.leinss.xyz/webhook/meeting-protokoll';
const calUrl = isDE ? config.external_links.strategy_call_de : config.external_links.strategy_call_en;

// Audio upload + Whisper + LLM can run long on a cold start; abort well above the ~60 s hint.
const TIMEOUT_MS = 120000;

// Canned fallback shown when the live endpoint is unreachable (timeout/network/offline).
const SAMPLE = {
  transcript_words: 1240,
  summary: isDE
    ? [
        'Q3-Roadmap besprochen – Priorität auf Rechnungsautomatisierung und CRM-Anbindung.',
        'Budget für das neue Automatisierungstool wurde freigegeben.',
        'Feature X wird auf Q4 verschoben, um Kapazität für die Integration zu schaffen.',
      ]
    : [
        'Discussed the Q3 roadmap — priority on invoice automation and CRM integration.',
        'Budget approved for the new automation tool.',
        'Feature X postponed to Q4 to free up capacity for the integration.',
      ],
  action_items: isDE
    ? [
        { assignee: 'Anna', task: 'Q3-Zeitplan entwerfen', due_date: 'bis Freitag' },
        { assignee: 'Stefan', task: 'Demo-Termine mit Anbietern koordinieren', due_date: 'nächste Woche' },
        { assignee: 'Maria', task: 'Anforderungen für die CRM-Integration dokumentieren', due_date: 'bis 15.' },
      ]
    : [
        { assignee: 'Alice', task: 'Draft the Q3 timeline', due_date: 'by Friday' },
        { assignee: 'Bob', task: 'Coordinate vendor demo sessions', due_date: 'next week' },
        { assignee: 'Carol', task: 'Document the CRM integration requirements', due_date: 'by the 15th' },
      ],
};

const t = {
  title: isDE ? 'Live-Demo: Meeting-Protokoll Bot' : 'Live Demo: Meeting Minutes Bot',
  subtitle: isDE
    ? 'Laden Sie eine Audioaufnahme hoch. Der Bot transkribiert und erstellt ein strukturiertes Protokoll.'
    : 'Upload an audio recording. The bot transcribes and creates a structured summary.',
  fileLabel: isDE ? 'Audioaufnahme auswählen' : 'Select audio recording',
  fileHint: isDE ? 'MP3, WAV, M4A, OGG · max. 25 MB' : 'MP3, WAV, M4A, OGG · max. 25 MB',
  titleLabel: isDE ? 'Meeting-Titel (optional)' : 'Meeting title (optional)',
  titlePlaceholder: isDE ? 'z. B. Wochentliches Team-Standup' : 'e.g. Weekly team standup',
  attendeesLabel: isDE ? 'Teilnehmer (optional, kommagetrennt)' : 'Attendees (optional, comma-separated)',
  attendeesPlaceholder: isDE ? 'z. B. Anna, Stefan, Maria' : 'e.g. Alice, Bob, Carol',
  submit: isDE ? 'Protokoll erstellen →' : 'Create Minutes →',
  loading: isDE ? 'Transkribiere und analysiere...' : 'Transcribing and analyzing...',
  loadingStep1: isDE ? 'Schritt 1/2: Spracherkennung (Whisper)' : 'Step 1/2: Speech recognition (Whisper)',
  loadingStep2: isDE ? 'Schritt 2/2: Protokoll-Erstellung (KI)' : 'Step 2/2: Minutes generation (AI)',
  loadingHint: isDE ? '~30–60 Sekunden' : '~30–60 seconds',
  resultTitle: isDE ? 'Meeting-Protokoll' : 'Meeting Minutes',
  summaryTitle: isDE ? 'Zusammenfassung' : 'Summary',
  actionsTitle: isDE ? 'Aufgaben' : 'Action Items',
  transcriptWords: isDE ? 'Wörter im Transkript' : 'Words in transcript',
  noActions: isDE ? 'Keine Aufgaben erkannt.' : 'No action items detected.',
  privacy: isDE
    ? '🔒 Ihre Audiodatei wird für die Transkription verarbeitet und danach nicht gespeichert.'
    : '🔒 Your audio file is processed for transcription and not stored afterward.',
  fileTooLarge: isDE ? 'Datei zu groß. Maximal 25 MB.' : 'File too large. Maximum 25 MB.',
  errorGeneric: isDE ? 'Verarbeitung fehlgeschlagen. Bitte erneut versuchen.' : 'Processing failed. Please try again.',
  tryAnother: isDE ? 'Nochmal testen' : 'Try another',
  offlineBadge: isDE
    ? '⚡ Live-Demo gerade offline – dies ist eine Beispielausgabe.'
    : '⚡ Live demo temporarily offline – this is sample output.',
  offlineCta: isDE ? 'Live-Demo im Gespräch ansehen →' : 'See it live — book a call →',
};
---

<div id="meeting-demo" class="mt-12 p-6 md:p-8 bg-white dark:bg-secondary-800/50 border border-secondary-200 dark:border-secondary-700 rounded-2xl not-prose">
  <div class="flex items-center gap-3 mb-2">
    <span class="flex items-center justify-center w-8 h-8 rounded-full bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
    </span>
    <h3 class="text-lg font-bold text-secondary-900 dark:text-white">{t.title}</h3>
  </div>
  <p class="text-secondary-600 dark:text-secondary-400 text-sm mb-6">{t.subtitle}</p>

  <form id="meeting-form" class="space-y-4">
    <div>
      <label class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2">
        {t.fileLabel}
      </label>
      <div class="relative border-2 border-dashed border-secondary-300 dark:border-secondary-600 rounded-xl p-6 text-center hover:border-purple-400 dark:hover:border-purple-500 transition-colors">
        <input type="file" id="meeting-file" accept=".mp3,.wav,.m4a,.ogg,audio/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 mx-auto mb-2 text-secondary-400 dark:text-secondary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
        </svg>
        <p id="meeting-filename" class="text-sm text-secondary-500 dark:text-secondary-400">{t.fileHint}</p>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label for="meeting-title" class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-1">{t.titleLabel}</label>
        <input type="text" id="meeting-title" placeholder={t.titlePlaceholder}
          class="w-full px-3 py-2 text-sm rounded-lg border border-secondary-300 dark:border-secondary-600 bg-white dark:bg-secondary-800 text-secondary-900 dark:text-white placeholder-secondary-400 focus:outline-hidden focus:ring-2 focus:ring-purple-500 focus:border-transparent" />
      </div>
      <div>
        <label for="meeting-attendees" class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-1">{t.attendeesLabel}</label>
        <input type="text" id="meeting-attendees" placeholder={t.attendeesPlaceholder}
          class="w-full px-3 py-2 text-sm rounded-lg border border-secondary-300 dark:border-secondary-600 bg-white dark:bg-secondary-800 text-secondary-900 dark:text-white placeholder-secondary-400 focus:outline-hidden focus:ring-2 focus:ring-purple-500 focus:border-transparent" />
      </div>
    </div>

    <p id="meeting-error" class="hidden text-sm text-red-600 dark:text-red-400"></p>

    <button type="submit" id="meeting-submit" disabled
      class="w-full btn-secondary py-3 font-semibold opacity-50 cursor-not-allowed transition-all">
      {t.submit}
    </button>

    <p class="text-xs text-secondary-400 dark:text-secondary-500">{t.privacy}</p>
  </form>

  <div id="meeting-loading" class="hidden mt-6 text-center py-8 space-y-3">
    <div class="inline-flex items-center gap-3 text-secondary-600 dark:text-secondary-400">
      <svg class="animate-spin w-5 h-5 text-purple-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
      <span id="meeting-loading-step" class="font-medium">{t.loading}</span>
    </div>
    <p class="text-xs text-secondary-400">({t.loadingHint})</p>
  </div>

  <div id="meeting-results" class="hidden mt-6 space-y-4">
    <div id="meeting-offline" class="hidden p-3 rounded-lg bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 text-xs text-amber-800 dark:text-amber-300">
      {t.offlineBadge}
    </div>
    <div class="flex items-center justify-between">
      <h4 class="font-semibold text-secondary-900 dark:text-white flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        {t.resultTitle}
      </h4>
      <span id="meeting-wordcount" class="text-xs text-secondary-400 dark:text-secondary-500"></span>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-secondary-500 dark:text-secondary-400 mb-2">{t.summaryTitle}</p>
      <ul id="meeting-summary" class="space-y-1.5"></ul>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-secondary-500 dark:text-secondary-400 mb-2">{t.actionsTitle}</p>
      <ul id="meeting-actions" class="space-y-1.5"></ul>
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <button id="meeting-retry" class="text-sm text-primary-600 dark:text-primary-400 hover:underline">
        ← {t.tryAnother}
      </button>
      <a id="meeting-offline-cta" href="" target="_blank" rel="noopener noreferrer"
        class="hidden inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg bg-primary-600 hover:bg-primary-700 text-white transition-colors">
        {t.offlineCta}
      </a>
    </div>
  </div>
</div>

<script define:vars={{ WEBHOOK_URL, t, lang, calUrl, SAMPLE, TIMEOUT_MS }}>
  const form = document.getElementById('meeting-form');
  const fileInput = document.getElementById('meeting-file');
  const filenameEl = document.getElementById('meeting-filename');
  const submitBtn = document.getElementById('meeting-submit');
  const errorEl = document.getElementById('meeting-error');
  const loadingEl = document.getElementById('meeting-loading');
  const loadingStep = document.getElementById('meeting-loading-step');
  const resultsEl = document.getElementById('meeting-results');
  const summaryEl = document.getElementById('meeting-summary');
  const actionsEl = document.getElementById('meeting-actions');
  const wordcountEl = document.getElementById('meeting-wordcount');
  const retryBtn = document.getElementById('meeting-retry');
  const offlineEl = document.getElementById('meeting-offline');
  const offlineCta = document.getElementById('meeting-offline-cta');

  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    if (file.size > 25 * 1024 * 1024) {
      showError(t.fileTooLarge);
      fileInput.value = '';
      return;
    }
    filenameEl.textContent = file.name;
    submitBtn.disabled = false;
    submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
    hideError();
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const file = fileInput.files?.[0];
    if (!file) return;

    form.classList.add('hidden');
    loadingEl.classList.remove('hidden');
    resultsEl.classList.add('hidden');

    // Switch loading message after ~15s to hint at step 2
    const stepTimer = setTimeout(() => {
      loadingStep.textContent = t.loadingStep2;
    }, 15000);

    try {
      const fd = new FormData();
      fd.append('file', file);
      fd.append('title', document.getElementById('meeting-title').value.trim() || 'Meeting');
      fd.append('attendees', document.getElementById('meeting-attendees').value.trim());
      fd.append('language', lang);

      const resp = await fetch(WEBHOOK_URL, { method: 'POST', body: fd, signal: AbortSignal.timeout(TIMEOUT_MS) });
      clearTimeout(stepTimer);
      const data = await resp.json().catch(() => null);
      // Treat an unexpected/empty 200 (no minutes shape) as a failure → sample fallback,
      // so a misconfigured backend never renders a blank "result" as if it succeeded.
      const valid = data && (Array.isArray(data.summary) || Array.isArray(data.action_items));
      if (!resp.ok || !valid) throw new Error(`HTTP ${resp.status}`);
      renderResults(data);
    } catch (err) {
      clearTimeout(stepTimer);
      console.error('[MeetingBotDemo]', err);
      renderFallback();
    }
  });

  retryBtn.addEventListener('click', () => {
    resultsEl.classList.add('hidden');
    form.classList.remove('hidden');
    fileInput.value = '';
    filenameEl.textContent = t.fileHint;
    submitBtn.disabled = true;
    submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
    document.getElementById('meeting-title').value = '';
    document.getElementById('meeting-attendees').value = '';
    loadingStep.textContent = t.loading;
    offlineEl.classList.add('hidden');
    offlineCta.classList.add('hidden');
  });

  // Endpoint unreachable (timeout/network/offline): show a canned sample + booking CTA.
  function renderFallback() {
    renderResults(SAMPLE);
    offlineEl.classList.remove('hidden');
    offlineCta.href = calUrl;
    offlineCta.classList.remove('hidden');
  }

  function makeBullet(text, isAction) {
    const li = document.createElement('li');
    li.className = 'flex items-start gap-2 text-sm text-secondary-700 dark:text-secondary-300';
    const icon = document.createElement('span');
    icon.className = isAction
      ? 'shrink-0 mt-0.5 w-4 h-4 rounded-sm border border-secondary-300 dark:border-secondary-600'
      : 'shrink-0 mt-1.5 w-1.5 h-1.5 rounded-full bg-primary-500';
    li.appendChild(icon);
    const span = document.createElement('span');
    span.textContent = text;
    li.appendChild(span);
    return li;
  }

  function renderResults(data) {
    loadingEl.classList.add('hidden');
    resultsEl.classList.remove('hidden');

    if (data.transcript_words) {
      wordcountEl.textContent = `${data.transcript_words} ${t.transcriptWords}`;
    }

    const summary = Array.isArray(data.summary) ? data.summary : [];
    summaryEl.replaceChildren(...summary.map((s) => makeBullet(s, false)));

    const actions = Array.isArray(data.action_items) ? data.action_items : [];
    if (actions.length === 0) {
      actionsEl.replaceChildren(makeBullet(t.noActions, false));
    } else {
      const items = actions.map((a) => {
        const text = typeof a === 'string' ? a : [a.assignee, a.task, a.due_date].filter(Boolean).join(' · ');
        return makeBullet(text, true);
      });
      actionsEl.replaceChildren(...items);
    }
  }

  function showError(msg) { errorEl.textContent = msg; errorEl.classList.remove('hidden'); }
  function hideError() { errorEl.classList.add('hidden'); }
</script>
