---
import { Image } from "astro:assets"
import { AiOutlineRobot } from "react-icons/ai"
import { BiAnalyse } from "react-icons/bi"
import { RiCustomerService2Line } from "react-icons/ri"
import config from "../assets/config.ts"
import i18n from "../assets/i18n.json"
import hero from "../assets/images/content/hero.png"

interface Props {
  lang: "en" | "de";
}

// Get language from props
const { lang } = Astro.props;
const t = i18n[lang];
---

<section
  class="relative py-12 md:py-20 overflow-hidden hero-section bg-primary-50 dark:bg-primary-950 dark:to-secondary-950"
  id="hero"
>
  <div class="absolute inset-0 z-0 opacity-30">
    <div class="absolute inset-0 bg-grid-pattern"></div>
  </div>
  <div class="container-custom relative z-10">
    <div class="slide-up" transition:animate="slide">
      <h3
        class="text-secondary-600 dark:text-secondary-300 mb-6 font-light tracking-wide"
      >
        {t.hero.subline}
      </h3>
      <h1 class="mb-8 text-secondary-900 dark:text-white leading-tight text-center">
        {t.hero.headline_start}<br />
        <span class="text-primary-600 dark:text-primary-400"
          >- {t.hero.headline_end}</span
        >
      </h1>
      <p
        class="text-base sm:text-lg md:text-xl text-secondary-600 dark:text-secondary-300 mb-12 md:mb-16 lg:mb-24 max-w-2xl leading-relaxed whitespace-pre-line"
      >
        {t.hero.intro_text}
      </p>

      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div
          class="space-y-6 h-[300px] md:h-full slide-up"
          transition:animate="slide"
        >
          <Image
            src={hero}
            alt="Hero"
            class="w-full h-full rounded-lg shadow-lg object-cover"
            loading="eager"
          />
        </div>

        <ul class="text-secondary-600 dark:text-secondary-300 max-w-2xl">
          {
            [1, 2, 3].map((num) => (
              <li class="mb-4 md:mb-6">
                <div class="flex items-center mb-2">
                  <span class="inline-block mr-4 text-primary-600 dark:text-primary-400">
                    {num === 1 ? (
                      <BiAnalyse className="w-5 h-5 md:w-6 md:h-6" />
                    ) : num === 2 ? (
                      <AiOutlineRobot className="w-5 h-5 md:w-6 md:h-6" />
                    ) : num === 3 ? (
                      <RiCustomerService2Line className="w-5 h-5 md:w-6 md:h-6" />
                    ) : null}
                  </span>
                  <strong class="block text-base sm:text-lg md:text-xl text-secondary-900 dark:text-secondary-100">
                    {
                      t.hero[
                        `point_${num}_start` as keyof typeof t.hero
                      ]
                    }
                  </strong>
                </div>
                <div>
                  <span class="text-sm sm:text-base md:text-lg">
                    {
                      t.hero[
                        `point_${num}_end` as keyof typeof t.hero
                      ]
                    }
                  </span>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="flex flex-col items-center gap-3 mt-12 md:mt-16">
      <a
        href={lang === "de" ? config.external_links.strategy_call_de : config.external_links.strategy_call_en}
        class="btn-cta"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.hero.cta_primary}
      </a>
      <p class="text-sm sm:text-base md:text-lg text-secondary-500 dark:text-secondary-400">
        {t.hero.cta_reassurance}
      </p>
    </div>

    <!-- Cross-positioning bridge: own apps as work samples -->
    <p
      class="mt-6 max-w-2xl mx-auto text-center text-sm sm:text-base md:text-lg leading-relaxed text-secondary-600 dark:text-secondary-300"
    >
      {t.hero.apps_bridge}{" "}
      <a
        href={t.hero.apps_bridge_url}
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-primary-600 dark:text-primary-400 hover:underline whitespace-nowrap"
      >
        {t.hero.apps_bridge_cta}
      </a>
    </p>

    <!-- Uptime proof. The rest of the page asserts that this is engineered
         properly; this is the only claim on the site a stranger can verify
         without talking to me, which is why it sits this high. -->
    <p
      class="mt-3 max-w-2xl mx-auto text-center text-sm sm:text-base leading-relaxed text-secondary-600 dark:text-secondary-300"
    >
      {t.hero.uptime_proof}{" "}
      <a
        href={t.hero.uptime_proof_url}
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-primary-600 dark:text-primary-400 hover:underline whitespace-nowrap"
      >
        {t.hero.uptime_proof_cta}
      </a>
    </p>
  </div>
</section>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .fade-in svg {
    animation: float 6s ease-in-out infinite;
  }

  .bg-grid-pattern {
    background-size: 20px 20px;
    background-image: linear-gradient(
        to right,
        rgba(0, 0, 0, 0.1) 1px,
        transparent 1px
      ),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.1) 1px, transparent 1px);
  }

  .hero-section {
    position: relative;
    overflow: hidden;
  }
</style>
