---
import config from '../assets/config.ts';
import DemoLeadGate from './DemoLeadGate.astro';

interface Props {
  lang?: 'de' | 'en';
}
const { lang = 'de' } = Astro.props;
const isDE = lang === 'de';

const WEBHOOK_URL = 'https://n8n.funnel.leinss.xyz/webhook/blitz-antwort-lead';
const calUrl = isDE ? config.external_links.strategy_call_de : config.external_links.strategy_call_en;

// Abort the request after this long; the displayed hint is ~30-60 s, so allow headroom.
const TIMEOUT_MS = 90000;

// Canned fallback shown when the live endpoint is unreachable (timeout/network/offline).
const SAMPLE = {
  subject: isDE
    ? 'Ihre Anfrage zur CRM-Integration, kurzer Vorschlag'
    : 'Your CRM integration request: a quick proposal',
  body: isDE
    ? 'Guten Tag Frau Schneider,\n\nvielen Dank für Ihre Nachricht. Als Agentur mit rund 20 Mitarbeitenden stehen Sie vermutlich vor der Herausforderung, Kundendaten über mehrere Tools hinweg synchron zu halten.\n\nGenau dabei helfe ich regelmäßig: HubSpot oder Pipedrive sauber mit Projekt-Tools wie Asana oder Monday verbinden, ohne doppelte Pflege.\n\nHätten Sie diese Woche 15 Minuten für ein kurzes Gespräch? Sie können direkt einen Termin wählen.\n\nMit freundlichen Grüßen\nTobias Leinss'
    : "Hello Ms. Schneider,\n\nThank you for your message. As an agency of around 20 people, you're likely facing the challenge of keeping customer data in sync across several tools.\n\nThat's exactly what I help with: cleanly connecting HubSpot or Pipedrive to project tools like Asana or Monday, without double data entry.\n\nWould you have 15 minutes this week for a short call? You can pick a slot directly.\n\nBest regards,\nTobias Leinss",
  lead_score: 8,
  kategorie: 'agency',
};

const t = {
  title: isDE ? 'Live-Demo: Blitz-Antwort Generator' : 'Live Demo: Instant Response Generator',
  subtitle: isDE
    ? 'Füllen Sie das Formular aus und sehen Sie, wie die KI eine personalisierte Erstantwort generiert.'
    : 'Fill in the form and watch the AI generate a personalized first response.',
  namePlaceholder: isDE ? 'z. B. Maria Schneider' : 'e.g. Jane Smith',
  companyPlaceholder: isDE ? 'z. B. Apex GmbH' : 'e.g. Apex Ltd.',
  messagePlaceholder: isDE
    ? 'Beschreiben Sie kurz Ihr Anliegen oder Ihr Projekt...'
    : 'Briefly describe your request or project...',
  emailPlaceholder: 'max@example.com',
  nameLabel: isDE ? 'Ihr Name' : 'Your Name',
  companyLabel: isDE ? 'Unternehmen' : 'Company',
  messageLabel: isDE ? 'Ihre Nachricht' : 'Your Message',
  emailLabel: isDE ? 'E-Mail-Adresse' : 'Email Address',
  submit: isDE ? 'Antwort generieren →' : 'Generate Response →',
  loading: isDE ? 'KI generiert personalisierte Antwort...' : 'AI generating personalized response...',
  loadingHint: isDE ? '~30-60 Sekunden' : '~30-60 seconds',
  resultTitle: isDE ? 'Generierte Erstantwort' : 'Generated First Response',
  subject: isDE ? 'Betreff' : 'Subject',
  scoreLabel: isDE ? 'Lead Score' : 'Lead Score',
  tryAnother: isDE ? 'Nochmal testen' : 'Try another',
  noteTitle: isDE ? 'Hinweis' : 'Note',
  noteText: isDE
    ? 'Dies ist eine echte KI-generierte Antwort, nicht vorgefertigt. In Ihrer Implementierung würde diese E-Mail direkt an die angegebene Adresse gesendet.'
    : 'This is a real AI-generated response, not pre-written. In your implementation, this email would be sent directly to the given address.',
  errorRequired: isDE ? 'Bitte Name, Unternehmen und Nachricht ausfüllen.' : 'Please fill in name, company, and message.',
  errorGeneric: isDE ? 'Anfrage fehlgeschlagen. Bitte erneut versuchen.' : 'Request failed. Please try again.',
  rateLimited: isDE
    ? 'Tageslimit der Live-Demo erreicht. Bitte morgen wieder versuchen, oder direkt Kontakt aufnehmen.'
    : 'Live-demo daily limit reached. Please try again tomorrow: or get in touch directly.',
  offlineBadge: isDE
    ? '⚡ Live-Demo gerade offline, dies ist eine Beispielausgabe.'
    : '⚡ Live demo temporarily offline. This is sample output.',
  offlineCta: isDE ? 'Live-Demo im Gespräch ansehen →' : 'See it live: book a call →',
  selfHosted: isDE
    ? '⚙️ Kein Mock-up: Ihre Anfrage läuft durch selbst gehostetes n8n auf Infrastruktur in der EU, die ich selbst betreibe, nicht durch einen gemieteten Cloud-Dienst.'
    : '⚙️ Not a mock-up: your request runs through self-hosted n8n on infrastructure I host and control in the EU, not a rented cloud service.',
  kategorie: {
    smb: isDE ? 'KMU' : 'SMB',
    agency: isDE ? 'Agentur' : 'Agency',
    enterprise: 'Enterprise',
    individual: isDE ? 'Privatperson' : 'Individual',
  },
  artifactLabel: isDE ? 'die komplette Antwort (.md)' : 'the complete response (.md)',
  // Downloadable take-home artifact.
  fileTitle: isDE ? 'KI-generierte Erstantwort' : 'AI-generated first response',
  fileSubject: isDE ? 'Betreff' : 'Subject',
  fileScore: isDE ? 'Lead-Score' : 'Lead score',
  fileFooter: isDE
    ? 'Erstellt mit der Live-Demo auf leinss-consulting.de, selbst gehostetes n8n + LLM. Die n8n-Workflow-Vorlage (Eingang → Klassifizierung → Antwort-Entwurf) bespreche ich im Erstgespräch.'
    : 'Generated with the live demo on leinss-consulting.de, self-hosted n8n + LLM. The n8n workflow blueprint (inbox → classification → draft reply) is walked through in the intro call.',
};
---

<div id="blitz-demo" class="mt-12 p-6 md:p-8 bg-white dark:bg-secondary-800/50 border border-secondary-200 dark:border-secondary-700 rounded-2xl not-prose">
  <div class="flex items-center gap-3 mb-2">
    <span class="flex items-center justify-center w-8 h-8 rounded-full bg-accent-100 dark:bg-accent-900/30 text-accent-600 dark:text-accent-400">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
    </span>
    <h3 class="text-lg font-bold text-secondary-900 dark:text-white">{t.title}</h3>
  </div>
  <p class="text-secondary-600 dark:text-secondary-400 text-sm mb-6">{t.subtitle}</p>

  <form id="blitz-form" class="space-y-4">
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label for="blitz-name" class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-1">{t.nameLabel}</label>
        <input type="text" id="blitz-name" placeholder={t.namePlaceholder}
          class="w-full px-3 py-2 text-sm rounded-lg border border-secondary-300 dark:border-secondary-600 bg-white dark:bg-secondary-800 text-secondary-900 dark:text-white placeholder-secondary-400 focus:outline-hidden focus:ring-2 focus:ring-primary-500 focus:border-transparent" />
      </div>
      <div>
        <label for="blitz-company" class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-1">{t.companyLabel}</label>
        <input type="text" id="blitz-company" placeholder={t.companyPlaceholder}
          class="w-full px-3 py-2 text-sm rounded-lg border border-secondary-300 dark:border-secondary-600 bg-white dark:bg-secondary-800 text-secondary-900 dark:text-white placeholder-secondary-400 focus:outline-hidden focus:ring-2 focus:ring-primary-500 focus:border-transparent" />
      </div>
    </div>

    <div>
      <label for="blitz-message" class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-1">{t.messageLabel}</label>
      <textarea id="blitz-message" rows="4" placeholder={t.messagePlaceholder}
        class="w-full px-3 py-2 text-sm rounded-lg border border-secondary-300 dark:border-secondary-600 bg-white dark:bg-secondary-800 text-secondary-900 dark:text-white placeholder-secondary-400 focus:outline-hidden focus:ring-2 focus:ring-primary-500 focus:border-transparent resize-none"></textarea>
    </div>

    <div>
      <label for="blitz-email" class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-1">{t.emailLabel}</label>
      <input type="email" id="blitz-email" placeholder={t.emailPlaceholder}
        class="w-full px-3 py-2 text-sm rounded-lg border border-secondary-300 dark:border-secondary-600 bg-white dark:bg-secondary-800 text-secondary-900 dark:text-white placeholder-secondary-400 focus:outline-hidden focus:ring-2 focus:ring-primary-500 focus:border-transparent" />
    </div>

    <p id="blitz-error" class="hidden text-sm text-red-600 dark:text-red-400"></p>

    <button type="submit" id="blitz-submit" class="w-full btn-secondary py-3 font-semibold">
      {t.submit}
    </button>

    <p class="text-xs font-medium text-secondary-500 dark:text-secondary-400">{t.selfHosted}</p>
  </form>

  <div id="blitz-loading" class="hidden mt-6 text-center py-8">
    <div class="inline-flex items-center gap-3 text-secondary-600 dark:text-secondary-400">
      <svg class="animate-spin w-5 h-5 text-primary-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
      <span class="font-medium">{t.loading}</span>
      <span class="text-xs opacity-70">({t.loadingHint})</span>
    </div>
  </div>

  <div id="blitz-results" class="hidden mt-6 space-y-4">
    <div id="blitz-offline" class="hidden p-3 rounded-lg bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 text-xs text-amber-800 dark:text-amber-300">
      {t.offlineBadge}
    </div>
    <div class="flex items-center justify-between">
      <h4 class="font-semibold text-secondary-900 dark:text-white flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        {t.resultTitle}
      </h4>
      <div class="flex items-center gap-2">
        <span id="blitz-score-badge" class="hidden px-2 py-0.5 text-xs font-semibold rounded-full bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300"></span>
        <span id="blitz-category-badge" class="hidden px-2 py-0.5 text-xs font-medium rounded-full bg-secondary-100 dark:bg-secondary-700 text-secondary-600 dark:text-secondary-300"></span>
      </div>
    </div>

    <div class="rounded-lg border border-secondary-200 dark:border-secondary-700 overflow-hidden">
      <div class="px-4 py-2 bg-secondary-50 dark:bg-secondary-800 border-b border-secondary-200 dark:border-secondary-700">
        <p class="text-xs text-secondary-500 dark:text-secondary-400 font-medium">{t.subject}</p>
        <p id="blitz-subject" class="text-sm font-semibold text-secondary-900 dark:text-white mt-0.5"></p>
      </div>
      <div class="p-4 bg-white dark:bg-secondary-800/50">
        <pre id="blitz-body" class="text-sm text-secondary-700 dark:text-secondary-300 whitespace-pre-wrap font-sans leading-relaxed"></pre>
      </div>
    </div>

    <div class="p-3 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-lg">
      <p class="text-xs font-medium text-amber-800 dark:text-amber-300">{t.noteTitle}</p>
      <p class="text-xs text-amber-700 dark:text-amber-400 mt-1">{t.noteText}</p>
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <button id="blitz-retry" class="text-sm text-primary-600 dark:text-primary-400 hover:underline">
        ← {t.tryAnother}
      </button>
      <a id="blitz-offline-cta" href="" target="_blank" rel="noopener noreferrer"
        class="hidden inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg bg-primary-600 hover:bg-primary-700 text-white transition-colors">
        {t.offlineCta}
      </a>
    </div>

    <DemoLeadGate lang={lang} id="blitz" artifactLabel={t.artifactLabel} />
  </div>
</div>

<script define:vars={{ WEBHOOK_URL, t, calUrl, SAMPLE, TIMEOUT_MS, lang }}>
  const form = document.getElementById('blitz-form');
  const nameInput = document.getElementById('blitz-name');
  const companyInput = document.getElementById('blitz-company');
  const messageInput = document.getElementById('blitz-message');
  const emailInput = document.getElementById('blitz-email');
  const errorEl = document.getElementById('blitz-error');
  const loadingEl = document.getElementById('blitz-loading');
  const resultsEl = document.getElementById('blitz-results');
  const subjectEl = document.getElementById('blitz-subject');
  const bodyEl = document.getElementById('blitz-body');
  const scoreBadge = document.getElementById('blitz-score-badge');
  const categoryBadge = document.getElementById('blitz-category-badge');
  const retryBtn = document.getElementById('blitz-retry');
  const offlineEl = document.getElementById('blitz-offline');
  const offlineCta = document.getElementById('blitz-offline-cta');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = nameInput.value.trim();
    const company = companyInput.value.trim();
    const message = messageInput.value.trim();
    const email = emailInput.value.trim();

    if (!name || !company || !message) {
      showError(t.errorRequired);
      return;
    }
    hideError();

    form.classList.add('hidden');
    loadingEl.classList.remove('hidden');

    try {
      const resp = await fetch(WEBHOOK_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, company, message, email }),
        signal: AbortSignal.timeout(TIMEOUT_MS),
      });
      const data = await resp.json().catch(() => null);
      // Rate-limited by the demo gateway (per-IP burst or global daily cap).
      if (resp.status === 429) {
        loadingEl.classList.add('hidden');
        form.classList.remove('hidden');
        showError((data && data.message) || t.rateLimited);
        return;
      }
      // No success flag from this endpoint; require the generated body. An unexpected/empty
      // 200 → sample fallback rather than showing "(keine Antwort generiert)" as a real reply.
      if (!resp.ok || !data || !data.body) throw new Error(`HTTP ${resp.status}`);
      renderResults(data);
    } catch (err) {
      console.error('[BlitzAntwortDemo]', err);
      renderFallback();
    }
  });

  retryBtn.addEventListener('click', () => {
    resultsEl.classList.add('hidden');
    form.classList.remove('hidden');
    nameInput.value = '';
    companyInput.value = '';
    messageInput.value = '';
    emailInput.value = '';
    offlineEl.classList.add('hidden');
    offlineCta.classList.add('hidden');
    document.getElementById('blitz-gate')?.classList.add('hidden');
  });

  // Endpoint unreachable (timeout/network/offline): show a canned sample + booking CTA.
  function renderFallback() {
    renderResults(SAMPLE);
    offlineEl.classList.remove('hidden');
    offlineCta.href = calUrl;
    offlineCta.classList.remove('hidden');
  }

  function renderResults(data) {
    loadingEl.classList.add('hidden');
    resultsEl.classList.remove('hidden');

    subjectEl.textContent = data.subject || '(kein Betreff)';
    bodyEl.textContent = data.body || '(keine Antwort generiert)';

    if (data.lead_score) {
      scoreBadge.textContent = `Score: ${data.lead_score}/10`;
      scoreBadge.classList.remove('hidden');
    }
    if (data.kategorie) {
      categoryBadge.textContent = t.kategorie[data.kategorie] || data.kategorie;
      categoryBadge.classList.remove('hidden');
    }

    armGate(data);
  }

  // Gate the take-home artifact: a downloadable Markdown copy of the full reply.
  function armGate(data) {
    const gateEl = document.getElementById('blitz-gate');
    if (!gateEl || !window.__demoGate) return;
    const lines = [`# ${t.fileTitle}`, ''];
    lines.push(`**${t.fileSubject}:** ${data.subject || ''}`, '');
    if (data.lead_score) lines.push(`**${t.fileScore}:** ${data.lead_score}/10`, '');
    lines.push('---', '', data.body || '', '', '---', t.fileFooter, '');
    window.__demoGate.arm('blitz', {
      text: lines.join('\n'),
      filename: lang === 'de' ? 'blitz-antwort.md' : 'instant-response.md',
      mime: 'text/markdown;charset=utf-8;',
    });
    gateEl.classList.remove('hidden');
  }

  function showError(msg) { errorEl.textContent = msg; errorEl.classList.remove('hidden'); }
  function hideError() { errorEl.classList.add('hidden'); }
</script>
