---
// Root redirect. A language the visitor chose beats the one their browser
// reports, because the choice is the more recent and more deliberate signal.
// Falls back to browser locale: German browsers → /de/, all others → /en/.
//
// Only this page redirects. A deep link always renders the language it names,
// so a shared URL cannot open in a different language than the sender saw.
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Leinss Consulting - Redirecting...</title>
    <meta name="robots" content="noindex" />
    <!-- Fallback for no-JS: default to German -->
    <noscript>
      <meta http-equiv="refresh" content="0;url=/de/" />
    </noscript>
    <script is:inline>
      (function () {
        var chosen = null
        try {
          chosen = localStorage.getItem("preferredLang")
        } catch (e) {
          // Storage blocked; fall through to browser locale.
        }
        if (chosen !== "de" && chosen !== "en") {
          // Browser language, e.g. "de", "de-DE", "en-US".
          var reported = navigator.language || navigator.userLanguage || "de"
          chosen = reported.toLowerCase().indexOf("de") === 0 ? "de" : "en"
        }
        window.location.replace("/" + chosen + "/")
      })()
    </script>
  </head>
  <body>
    <p>Redirecting...</p>
  </body>
</html>
