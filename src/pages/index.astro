---
// This file is just a redirect to the German version
import i18n from "../assets/i18n.json"

const lang = "de"

const {
  title,
  description = i18n[lang as keyof typeof i18n].meta.description,
} = Astro.props
---

<head>
  <meta http-equiv="refresh" content="0;url=/ki-kommunikation" />

  <meta name="robots" content="noindex, follow" />
  <link rel="canonical" href="/ki-kommunikation" />
  <link rel="alternate" hreflang="de" href="/ki-kommunikation" />
  <link rel="alternate" hreflang="en" href="/ai-communication" />

  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description} />
  <meta name="image" content={"/images/hero.png"} />

  <meta name="type" content="article" />
  <meta property="article:published_time" content="2025-04-17T11:00:00Z" />

  <title>{title}</title>
</head>

<script>
  window.location.href = "/ki-kommunikation"
</script>
