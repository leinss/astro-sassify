---
export const prerender = true;

import { getCollection } from "astro:content"
import Layout from "../../../layouts/Layout.astro"
import Header from "../../../components/Header.astro"
import Footer from "../../../components/Footer.astro"
import BackToTop from "../../../components/BackToTop.astro"
import BlogCard from "../../../components/BlogCard.astro"
import i18n from "../../../assets/i18n.json"

const lang = "en"
const t = i18n[lang]

// Get all English blog posts, filter out drafts
const allPosts = await getCollection("blog", ({ data }) => {
  return data.lang === "en" && !data.draft
})

// Sort by date, newest first
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

// Count posts by type
const referenceBuildCount = posts.filter(p => p.data.category === 'reference-build').length
const caseStudyCount = posts.filter(p => p.data.category === 'case-study').length
const articleCount = posts.length - referenceBuildCount - caseStudyCount

const alternateHref = "/de/blog/"
---

<Layout
  title={`Blog - ${i18n[lang].meta.title}`}
  description="Articles and insights on business process automation, workflow optimization, and digital transformation."
  lang={lang}
  alternateUrl={alternateHref}
>
  <Header lang={lang} alternateHref={alternateHref} />

  <main class="min-h-screen bg-linear-to-b from-primary-50 to-white dark:from-secondary-950 dark:to-secondary-900">
    <!-- Hero Section -->
    <section class="py-16 md:py-24">
      <div class="container-custom">
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl font-bold text-secondary-900 dark:text-white mb-6">
            {t.header.blog}
          </h1>
          <p class="text-xl text-secondary-700 dark:text-secondary-400">
            Insights and best practices on automation, integration, and workflow optimization.
          </p>
        </div>
      </div>
    </section>

    <!-- Filter Tabs -->
    <section class="pb-8">
      <div class="container-custom">
        <div class="flex flex-wrap justify-center gap-2" role="tablist" aria-label="Filter posts">
          <button
            data-filter="all"
            class="filter-tab active px-4 py-2 rounded-full text-sm font-medium transition-all"
            role="tab"
            aria-selected="true"
          >
            All ({posts.length})
          </button>
          <button
            data-filter="article"
            class="filter-tab px-4 py-2 rounded-full text-sm font-medium transition-all"
            role="tab"
            aria-selected="false"
          >
            Articles ({articleCount})
          </button>
          <button
            data-filter="reference-build"
            class="filter-tab px-4 py-2 rounded-full text-sm font-medium transition-all"
            role="tab"
            aria-selected="false"
          >
            Reference Builds ({referenceBuildCount})
          </button>
          <button
            data-filter="case-study"
            class="filter-tab px-4 py-2 rounded-full text-sm font-medium transition-all"
            role="tab"
            aria-selected="false"
          >
            Case Studies ({caseStudyCount})
          </button>
        </div>
      </div>
    </section>

    <!-- Blog Grid -->
    <section class="pb-20">
      <div class="container-custom">
        {posts.length > 0 ? (
          <div id="blog-grid" class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <div data-category={post.data.category === 'reference-build' || post.data.category === 'case-study'
                ? post.data.category
                : 'article'}>
                <BlogCard post={post} lang={lang} />
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-12">
            <p class="text-secondary-700 dark:text-secondary-400 text-lg">
              New articles coming soon. Stay tuned!
            </p>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer lang={lang} />
  <BackToTop />
</Layout>

<style>
  .filter-tab {
    background: transparent;
    color: var(--color-secondary-600);
    border: 1px solid var(--color-secondary-200);
  }

  :global(.dark) .filter-tab {
    color: var(--color-secondary-400);
    border-color: var(--color-secondary-700);
  }

  .filter-tab:hover {
    background: var(--color-secondary-100);
  }

  :global(.dark) .filter-tab:hover {
    background: var(--color-secondary-800);
  }

  .filter-tab.active {
    background: var(--color-primary-700);
    color: white;
    border-color: var(--color-primary-700);
  }

  #blog-grid > div {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  #blog-grid > div.hidden {
    display: none;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const tabs = document.querySelectorAll('.filter-tab');
    const items = document.querySelectorAll('#blog-grid > div');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter');

        // Update active tab
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        // Filter items
        items.forEach(item => {
          const category = item.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            item.classList.remove('hidden');
          } else {
            item.classList.add('hidden');
          }
        });
      });
    });
  });
</script>
