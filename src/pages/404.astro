---
import Layout from "../layouts/Layout.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import i18n from "../assets/i18n.json"
import config from "../assets/config.ts"
---

<Layout title="Page Not Found - Tobias Leinss">
  <Header />
  <main>
    <section class="py-20 md:py-32">
      <div class="container-custom text-center">
        <h1
          class="text-9xl font-bold text-primary-600 dark:text-primary-400 mb-8"
          x-text="lang === 'de' ? window.i18n.de.page_not_found.title : window.i18n.en.page_not_found.title"
        ></h1>
        <h2
          class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4"
          x-text="lang === 'de' ? window.i18n.de.page_not_found.headline : window.i18n.en.page_not_found.headline"
        ></h2>
        <p
          class="text-xl text-gray-600 dark:text-gray-300 mb-8 max-w-2xl mx-auto"
          x-text="lang === 'de' ? window.i18n.de.page_not_found.text : window.i18n.en.page_not_found.text"
        ></p>
        <div class="flex justify-center gap-4 flex-wrap">
          <a href={`/#hero`} class="btn-primary" x-text="lang === 'de' ? window.i18n.de.page_not_found.back_to_home : window.i18n.en.page_not_found.back_to_home"></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
