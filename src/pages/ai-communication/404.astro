---
import Layout from "../../layouts/Layout.astro"
import Header from "../../components/Header.astro"
import Footer from "../../components/Footer.astro"
import i18n from "../../assets/i18n.json"

// English version
const lang = "en"
const t = i18n[lang]

// For GitHub Pages, we can't set the status code server-side

// Get the base path for links based on language
const basePath = "/ai-communication"
---

<Layout title="Page Not Found - Tobias Leinss">
  <Header lang={lang} />
  <main class="flex-1 flex flex-col">
    <section class="py-20 md:py-32 flex-1 flex items-center">
      <div class="container-custom text-center w-full">
        <h1
          class="text-9xl font-bold text-primary-600 dark:text-primary-400 mb-8"
        >
          {t.page_not_found.title}
        </h1>
        <h2
          class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4"
        >
          {t.page_not_found.headline}
        </h2>
        <p
          class="text-xl text-gray-600 dark:text-gray-300 mb-8 max-w-2xl mx-auto"
        >
          {t.page_not_found.text}
        </p>
        <div class="flex justify-center gap-4 flex-wrap">
          <a href={`${basePath}/#hero`} class="btn-primary">{t.page_not_found.back_to_home}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Layout>
