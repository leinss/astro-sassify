# =============================================================================
# Environment Variables for Leinss Consulting Website
# =============================================================================
# Copy this file to .env and fill in your values for local development.
# For production deployment via GitHub Actions, set these as repository secrets.
#
# GitHub Secrets Setup:
#   1. Go to your repo → Settings → Secrets and variables → Actions
#   2. Click "New repository secret"
#   3. Add each variable below as a secret
# =============================================================================

# -----------------------------------------------------------------------------
# Newsletter (Listmonk) Configuration
# -----------------------------------------------------------------------------
# Your Listmonk instance URL (no trailing slash)
LISTMONK_URL=https://listmonk.funnel.leinss.xyz

# API credentials - create in Listmonk: Settings → API Keys
# Required for newsletter subscription to work
LISTMONK_API_USER=your_api_username
LISTMONK_API_KEY=your_api_key

# The list ID to subscribe users to (found in Listmonk: Lists → ID column)
# Default: 1 (first list)
LISTMONK_LIST_ID=1
